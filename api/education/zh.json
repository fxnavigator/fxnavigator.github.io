      "lessons": [
        {
          "id": "smc_1",
          "title": "什么是Smart Money？",
          "subtitle": "市场流动性",
          "steps": [
            {
              "type": "animation",
              "lottieFile": "assets/lottie/smc_vacuum.json",
              "text": "市场有买方和卖方。大型银行（Smart Money）需要找到可以买入或卖出的人。他们找到这些人的地方称为\"流动性\"。这就是Smart Money的精髓！"
            },
            {
              "type": "animation",
              "lottieFile": "assets/lottie/smc_chart_grab.json",
              "text": "看看这张图表。这些高点和低点就是流动性区域。银行突破高点以猎取放置在那里的止损单，然后市场迅速朝真实方向反转。"
            },
            {
              "type": "interaction",
              "illustrationAsset": "assets/icons/chart_pattern.svg",
              "text": "现在在图表上找到吸筹区：它是高点还是低点？"
            }
          ],
          "quiz": [
            {
              "question": "什么是市场中的Smart Money？",
              "options": [
                "管理流动性的大型银行",
                "小型零售交易者",
                "经济新闻",
                "技术指标"
              ],
              "correctIndex": 0
            },
            {
              "question": "银行为什么要突破高点？",
              "options": [
                "为了猎取流动性（止损单）",
                "为了以更高价格买入",
                "为了做空",
                "为了显示图表"
              ],
              "correctIndex": 0
            }
          ]
        },
        {
